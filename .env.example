# ============================================================================
# Portfolio frontend — environment variables (Vite)
# Copy to `.env` and adjust. Only vars prefixed with VITE_ are exposed to the app.
# ============================================================================

# Base URL of the AbdullaX chat backend.
# Local dev (FastAPI/uvicorn default):
VITE_API_URL=http://127.0.0.1:8000
# Production (deployed backend — see .env.production, used by `vite build`):
# VITE_API_URL=https://abdullax.onrender.com
